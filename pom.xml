<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM padre del repositorio "Microservicios: Guía Táctica de Implementación".

  Agrupa los tres servicios de Seguros Brújula (cotización, emisión y recaudo).
  Las versiones de Spring, Testcontainers, Flyway, Kafka y el driver de
  PostgreSQL las gestiona spring-boot-starter-parent; aquí solo fijamos lo que
  Spring Boot no administra (ArchUnit).

  Comando principal:  mvn verify   (Maven 3.9+, Java 21+ y Docker para las pruebas de integración)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.tmsa.brujula</groupId>
    <artifactId>microservices-tactical-guide</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Seguros Brújula :: Guía Táctica de Microservicios</name>
    <description>Código de referencia del eBook "Microservicios: Guía Táctica de Implementación" (The Modern Software Architect)</description>

    <modules>
        <module>servicios/cotizacion</module>
        <module>servicios/emision</module>
        <module>servicios/recaudo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Las clases *IT son pruebas de integración: corren en "verify" con Failsafe. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
